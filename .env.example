# ──────────────────────────────────────────────────────────────
# Modo demonstração — portfólio público + rotas /demo e /preview
# ──────────────────────────────────────────────────────────────
# NEXT_PUBLIC_DEMO=true


# ──────────────────────────────────────────────────────────────
# Modo cliente — produção, somente rota home
# ──────────────────────────────────────────────────────────────

# Slug do cliente (deve corresponder à pasta no repo de clientes)
# NEXT_PUBLIC_CLIENT=joao-silva

# Repositório privado com as configs de todos os clientes
# Estrutura esperada: {GITHUB_CLIENTS_REPO}/{NEXT_PUBLIC_CLIENT}/{site,content,theme}.json
# GITHUB_CLIENTS_REPO=seu-usuario/landing-page-clients

# Token do GitHub com permissão de leitura no repo de clientes
# Crie em: GitHub → Settings → Developer settings → Personal access tokens
# Permissão necessária: Contents (read-only)
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx


# ──────────────────────────────────────────────────────────────
# Desenvolvimento local (sem token, usando arquivos locais)
# ──────────────────────────────────────────────────────────────
# Crie config/clients/{NEXT_PUBLIC_CLIENT}/{site,content,theme}.json
# e defina apenas NEXT_PUBLIC_CLIENT — o token não é necessário.
