# ──────────────────────────────────────────────
# Modo demonstração (portfólio + rotas /demo e /preview)
# ──────────────────────────────────────────────
# NEXT_PUBLIC_DEMO=true

# ──────────────────────────────────────────────
# Modo cliente (produção — somente rota home)
# ──────────────────────────────────────────────
# Identificador do cliente (usado no fallback de arquivos locais)
# NEXT_PUBLIC_CLIENT=joao-silva

# Config do cliente via variáveis de ambiente (recomendado para produção)
# Cada variável recebe o conteúdo do JSON correspondente como string.
# CONFIG_SITE='{"company":{"name":"...","namePrefix":"...","nameHighlight":"...","tagline":"...","logo":"/logos/logo.svg","email":"...","whatsapp":"55...","whatsappMessage":"..."},"social":{"instagram":null,"facebook":null,"linkedin":null},"nav":{"links":[],"mobileLinks":[],"cta":"..."},"seo":{"title":"...","description":"...","url":"https://...","ogImage":"/og-image.jpg"},"footer":{"copyright":"...","disclaimer":"..."}}'
# CONFIG_CONTENT='{"hero":{...},"benefits":{...},...}'
# CONFIG_THEME='{"colors":{"primary":"#2563eb","primaryHover":"#1d4ed8","secondary":"#10b981","secondaryHover":"#059669","accent":"#0f172a","background":"#f8fafc","surface":"#ffffff","text":"#0f172a","textMuted":"#64748b"},"fonts":{"heading":"Jakarta","body":"Jakarta"}}'
